{
  "manifest_version": 3,
  "name": "widget-helper",
  "permissions": [
    "cookies",
    "history",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
